# Core Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Telephony & Webhook Authentication (agent-security.md §6)
VAPI_SECRET_TOKEN=dev-vapi-secret
VAPI_API_KEY=mock-vapi-key
VAPI_ASSISTANT_ID=asst_dev123

# Google Calendar Integration (Least privilege service account or OAuth token)
CALENDAR_ID=primary
GOOGLE_CALENDAR_TOKEN=mock-token
GOOGLE_CALENDAR_BASE_URL=https://www.googleapis.com/calendar/v3

# Scheduling Business Invariants (CONTEXT.md §2)
CLINIC_NAME=Acme Clinic
CLINIC_TIMEZONE=America/New_York
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=17
DEFAULT_SLOT_DURATION_MINUTES=30
MAX_QUERY_DAYS=14

# Latency & Telephony Dead Air Budgets (voice-ai-standards.md §1)
WEBHOOK_TIMEOUT_SECONDS=2.5
